# Copy to .env for the optional account/sync server. Never commit actual secrets.
SHADOW_PORT=8787
SHADOW_ORIGIN=http://localhost:5173
SHADOW_PUBLIC_URL=http://localhost:5173
SHADOW_DB_PATH=./data/shadow.sqlite
# Optional: comma-separated exact IPs of controlled reverse proxies. Empty trusts none.
# Configure only after the proxy overwrites or appends X-Forwarded-For correctly.
SHADOW_TRUSTED_PROXIES=
# Base64-encoded 32-byte key; generate once and retain for encrypted connections.
SHADOW_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Email is optional; production must use smtp, never the development outbox.
# Use outbox explicitly for local testing only (private data/mail-outbox/*.eml).
SHADOW_MAIL_MODE=disabled
SHADOW_SMTP_HOST=
SHADOW_SMTP_PORT=587
SHADOW_SMTP_TLS=starttls
SHADOW_SMTP_USER=
SHADOW_SMTP_PASSWORD=
SHADOW_SMTP_FROM=
